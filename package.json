{
  "name": "cynthia",
  "version": "1.0.0",
  "private": true,
  "description": "Cynthia - an always-on AI assistant powered by Gemini, with its own computer, accounts and a PWA.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "check": "for f in server/*.js public/js/*.js public/sw.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.1.1",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "three": "^0.186.1",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
