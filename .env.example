# Required: your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: chat model (default: gemini-flash-latest) and image model
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Database. On Railway, add the PostgreSQL plugin and reference ${{Postgres.DATABASE_URL}}.
# Without it, SQLite is used in DATA_DIR (mount a volume there to keep data).
# DATABASE_URL=postgres://user:pass@host:5432/db
# DATA_DIR=./data

# Optional: session signing secret (auto-generated and stored in the database if unset)
# JWT_SECRET=

# Set to false to allow only the first account to sign up (private instance)
# ALLOW_SIGNUPS=true

# Optional: Web Push keys (auto-generated and stored in the database if unset)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional: path to Chromium for the built-in browser (the Dockerfile sets this)
# CHROMIUM_PATH=/usr/bin/chromium

# Max tool-calling steps per message
# MAX_AGENT_STEPS=16

# Let the agent reach private/internal network addresses (keep false on public servers)
# ALLOW_PRIVATE_NETWORK=false
